{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles and contact details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "pincode": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "orders": {
      "title": "Customer Orders",
      "description": "Store orders placed by customers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "deliveryType": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "totalAmount", "status"]
    },
    "cart": {
      "title": "User Shopping Carts",
      "description": "Saved active shopping carts for logged in users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  }
}
